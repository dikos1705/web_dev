{
  "info": {
    "name": "Space Bounty Hunters - Midterm",
    "description": "Run in order against the seeded API. Creates one temporary hunt and deletes it. All mandatory filters, CRUD, timestamps and invalid requests are checked.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "criminalId",
      "value": ""
    },
    {
      "key": "huntId",
      "value": ""
    },
    {
      "key": "createdAt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - List criminals and save a valid ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/criminals/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "pm.test(\"At least 5 criminals\", () => pm.expect(rows.length).to.be.at.least(5));",
              "pm.collectionVariables.set(\"criminalId\", rows[0].id);",
              "pm.test(\"Rewards ascending\", () => { const r = rows.map(x => Number(x.reward)); pm.expect(r).to.eql([...r].sort((a,b)=>a-b)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Minimum bounty, armed, descending",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/criminals/?min_reward=5000&armed=true&sort=-reward"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const rows = pm.response.json();",
              "pm.test(\"Combined filters\", () => { pm.expect(rows.length).to.be.above(0); rows.forEach(x => { pm.expect(Number(x.reward)).to.be.at.least(5000); pm.expect(x.armed).to.be.true; }); });",
              "pm.test(\"Rewards descending\", () => { const r = rows.map(x=>Number(x.reward)); pm.expect(r).to.eql([...r].sort((a,b)=>b-a)); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - All filters including false values",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/criminals/?min_reward=5000&max_reward=9000&armed=true&has_crew=false&escape_master=false&sort=reward"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Every filter applied\", () => { const rows=pm.response.json(); pm.expect(rows.length).to.be.above(0); rows.forEach(x => { pm.expect(Number(x.reward)).to.be.within(5000,9000); pm.expect(x.armed).to.be.true; pm.expect(x.has_crew).to.be.false; pm.expect(x.escape_master).to.be.false; }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Criminal details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/criminals/{{criminalId}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Correct criminal\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"criminalId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - List hunt logs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hunts/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"At least 10 logs\", () => pm.expect(pm.response.json().length).to.be.at.least(10));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Filter hunt logs by criminal",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hunts/?criminal_id={{criminalId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Only requested criminal\", () => { const rows=pm.response.json(); pm.expect(rows.length).to.be.at.least(2); rows.forEach(x => pm.expect(x.criminal_id).to.eql(Number(pm.collectionVariables.get(\"criminalId\")))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Create hunt attempt",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/hunts/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"criminal_id\": {{criminalId}},\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const hunt=pm.response.json(); pm.collectionVariables.set(\"huntId\",hunt.id); pm.collectionVariables.set(\"createdAt\",hunt.created_at);",
              "pm.test(\"Server generated timestamp\", () => { pm.expect(Number.isNaN(Date.parse(hunt.created_at))).to.be.false; pm.expect(Math.abs(Date.now()-Date.parse(hunt.created_at))).to.be.below(60000); });",
              "pm.test(\"Created data and Location\", () => { pm.expect(hunt.success).to.be.false; pm.expect(hunt.notes).to.eql(\"Target escaped through an asteroid field.\"); pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/hunts/\"+hunt.id+\"/\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Read created hunt",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/hunts/{{huntId}}/"
