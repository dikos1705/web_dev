            ]
          }
        }
      ]
    },
    {
      "name": "09 - Update success only",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/hunts/{{huntId}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"success\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Partial update preserves notes and timestamp\", () => { const h=pm.response.json(); pm.expect(h.success).to.be.true; pm.expect(h.notes).to.eql(\"Target escaped through an asteroid field.\"); pm.expect(h.created_at).to.eql(pm.collectionVariables.get(\"createdAt\")); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Update notes only",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/hunts/{{huntId}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"Captured near the Europa outpost.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Notes changed; success preserved\", () => { const h=pm.response.json(); pm.expect(h.success).to.be.true; pm.expect(h.notes).to.eql(\"Captured near the Europa outpost.\"); pm.expect(h.created_at).to.eql(pm.collectionVariables.get(\"createdAt\")); });"
            ]
          }
        }
      ]
    },
