    {
      "name": "Create reservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/bookings",
        "description": "Create reservation. See docs/API.md for invariants and error responses.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"flight_id\": {{flightId}},\n  \"seat\": \"1A\",\n  \"fare\": \"standard\",\n  \"passenger_name\": \"Alex Morgan\",\n  \"email\": \"alex@example.com\",\n  \"request_key\": \"{{requestKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"requestKey\",pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const b=pm.response.json();",
              "pm.environment.set(\"bookingId\",b.id);",
              "pm.environment.set(\"bookingToken\",b.manage_token);",
              "pm.test(\"Server computes fare\",()=>pm.expect(b.total_kzt).to.eql(52500));"
            ]
          }
        }
      ]
    },
