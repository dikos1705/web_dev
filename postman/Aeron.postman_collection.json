    {
      "name": "Protect admin writes",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/flights",
        "description": "Protect admin writes. See docs/API.md for invariants and error responses.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"AE9999\",\n  \"origin_code\": \"ALA\",\n  \"destination_code\": \"NQZ\",\n  \"departure_at\": \"{{departure}}\",\n  \"arrival_at\": \"{{arrival}}\",\n  \"price_kzt\": 40000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"departure\", new Date(Date.now()+40*86400000).toISOString());",
              "pm.environment.set(\"arrival\", new Date(Date.now()+40*86400000+6000000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create flight",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Admin-Key",
            "value": "{{adminKey}}"
          }
        ],
        "url": "{{baseUrl}}/api/flights",
        "description": "Create flight. See docs/API.md for invariants and error responses.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"number\": \"AE9999\",\n  \"origin_code\": \"ALA\",\n  \"destination_code\": \"NQZ\",\n  \"departure_at\": \"{{departure}}\",\n  \"arrival_at\": \"{{arrival}}\",\n  \"price_kzt\": 40000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const t=Date.now()+40*86400000;",
              "pm.environment.set(\"departure\",new Date(t).toISOString());",
              "pm.environment.set(\"arrival\",new Date(t+6000000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.environment.set(\"flightId\", pm.response.json().id);",
              "pm.test(\"Empty cabin\", () => pm.expect(pm.response.json().available_seats).to.eql(24));"
            ]
          }
        }
      ]
    },
