{
  "info": {
    "name": "Dayboard - Midterm CRUD and validation",
    "description": "Run all requests in order with Collection Runner. Request 04 creates a task and captures taskId automatically; request 14 deletes it. No manual IDs or authentication required. Set baseUrl to your local port. Negative requests intentionally expect 400/404.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string"
    },
    {
      "key": "runTitle",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Health and database",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Database connected', () => pm.expect(pm.response.json().database).to.eql('connected'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Application information",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/info"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Application name', () => pm.expect(pm.response.json().name).to.eql('Dayboard'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - List tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Tasks is an array', () => pm.expect(pm.response.json().tasks).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Create task and save ID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{runTitle}}\",\n  \"priority\": \"high\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runTitle', 'Postman task ' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const task = pm.response.json(); pm.collectionVariables.set('taskId', task.id);",
              "pm.test('Created task has ID, title and defaults', () => { pm.expect(task.id).to.be.a('number'); pm.expect(task.title).to.eql(pm.collectionVariables.get('runTitle')); pm.expect(task.completed).to.eql(false); pm.expect(task.priority).to.eql('high'); });",
              "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/tasks/' + task.id));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Get task by saved ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Correct task ID', () => { pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('taskId'))); });",
              "pm.test('ISO timestamp', () => pm.expect(pm.response.json().created_at).to.match(/^\\d{4}-\\d{2}-\\d{2}T/));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Replace task with PUT",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated through Postman\",\n  \"priority\": \"low\",\n  \"completed\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('All fields replaced', () => { const t=pm.response.json(); pm.expect(t.title).to.eql('Updated through Postman'); pm.expect(t.priority).to.eql('low'); pm.expect(t.completed).to.eql(false); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Complete task with PATCH",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Omitted fields retained', () => { const t=pm.response.json(); pm.expect(t.completed).to.eql(true); pm.expect(t.title).to.eql('Updated through Postman'); pm.expect(t.priority).to.eql('low'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Filter and search tasks",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks?completed=true&priority=low&q=Postman"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Created task appears in filtered list', () => pm.expect(pm.response.json().tasks.map(t=>t.id)).to.include(Number(pm.collectionVariables.get('taskId'))));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Live task statistics",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/stats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Consistent totals', () => { const s=pm.response.json(); pm.expect(s.total).to.eql(s.completed+s.remaining); pm.expect(s.completed).to.be.at.least(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - OpenAPI specification",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/openapi.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('OpenAPI document', () => pm.expect(pm.response.json().openapi).to.eql('3.0.3'));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Reject empty title",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"   \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Clear validation message', () => pm.expect(pm.response.json().error).to.include('Title'));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Reject incomplete PUT",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Missing fields\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Required fields reported', () => pm.expect(pm.response.json().error).to.include('Missing required'));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Reject wrong boolean type",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": \"true\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Delete task",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));",
              "pm.test('Empty response body', () => pm.expect(pm.response.text()).to.eql(''));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Deleted task is not found",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Not found message', () => pm.expect(pm.response.json().error).to.eql('Task not found'));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 - Cannot update deleted task",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 - Frontend is served",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Dayboard HTML', () => pm.expect(pm.response.text()).to.include('dayboard'));"
            ]
          }
        }
      ]
    }
  ]
}
